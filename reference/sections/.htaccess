# 🚫 منع الوصول المباشر لأي ملف داخل هذا المجلد عبر الرابط
# هذي الملفات مخصصة للاستدعاء الداخلي فقط من mobile.php (عبر require)
# ولا يجب أن تُفتح أبداً كصفحة مستقلة.

# Apache 2.4+
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 (توافقية لو السيرفر أقدم)
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
