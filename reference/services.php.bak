<?php
require_once 'includes/config.php';
$pageTitle = 'الخدمات - ' . SITE_NAME;

$catId = isset($_GET['cat']) ? (int)$_GET['cat'] : null;

// جلب الأقسام الرئيسية
$mainCats = $pdo->query("SELECT * FROM categories WHERE parent_id IS NULL AND status=1 ORDER BY sort_order")->fetchAll();

// جلب الأقسام الفرعية للقسم المختار
$subCats = [];
if ($catId) {
    $stmt = $pdo->prepare("SELECT * FROM categories WHERE parent_id=? AND status=1 ORDER BY sort_order");
    $stmt->execute([$catId]);
    $subCats = $stmt->fetchAll();
}

// جلب الخدمات
if ($catId) {
    // جلب خدمات القسم وخدمات أقساميه الفرعية
    $subCatIds = array_column($subCats, 'id');
    $subCatIds[] = $catId;
    $in = implode(',', $subCatIds);
    $services = $pdo->query("
        SELECT s.*, c.name as cat_name, c.id as cat_id 
        FROM services s 
        JOIN categories c ON s.category_id = c.id 
        WHERE s.category_id IN ($in) AND s.status=1 
        ORDER BY c.sort_order, s.sort_order
    ")->fetchAll();
} else {
    $services = $pdo->query("
        SELECT s.*, c.name as cat_name, c.id as cat_id 
        FROM services s 
        JOIN categories c ON s.category_id = c.id 
        WHERE s.status=1 
        ORDER BY c.sort_order, s.sort_order
        LIMIT 50
    ")->fetchAll();
}

// جلب حقول كل خدمة
$serviceFields = [];
if ($services) {
    $sids = array_column($services, 'id');
    $in2 = implode(',', $sids);
    $fields = $pdo->query("SELECT * FROM service_fields WHERE service_id IN ($in2) ORDER BY sort_order")->fetchAll();
    foreach ($fields as $f) {
        $serviceFields[$f['service_id']][] = $f;
    }
}

include 'includes/header.php';
?>

<div class="page-header">
    <h2><i class="fas fa-th-large"></i> تصفح الخدمات</h2>
</div>

<!-- الأقسام الرئيسية -->
<div class="sub-cats" style="margin-bottom:1rem">
    <button class="sub-cat-btn <?= !$catId ? 'active' : '' ?>" onclick="location.href='services.php'">
        <i class="fas fa-th"></i> الكل
    </button>
    <?php foreach ($mainCats as $mc): ?>
    <button class="sub-cat-btn <?= $catId == $mc['id'] ? 'active' : '' ?>" 
            onclick="location.href='services.php?cat=<?= $mc['id'] ?>'">
        <i class="<?= htmlspecialchars($mc['icon']) ?>"></i> <?= htmlspecialchars($mc['name']) ?>
    </button>
    <?php endforeach; ?>
</div>

<!-- الأقسام الفرعية -->
<?php if ($subCats): ?>
<div class="sub-cats">
    <button class="sub-cat-btn active" onclick="filterCategory('all',this)">الكل</button>
    <?php foreach ($subCats as $sc): ?>
    <button class="sub-cat-btn" onclick="filterCategory(<?= $sc['id'] ?>,this)">
        <i class="<?= htmlspecialchars($sc['icon']) ?>"></i> <?= htmlspecialchars($sc['name']) ?>
    </button>
    <?php endforeach; ?>
</div>
<?php endif; ?>

<!-- قائمة الخدمات -->
<?php if ($services): ?>
<div class="services-grid">
    <?php foreach ($services as $svc): 
        $fields = $serviceFields[$svc['id']] ?? [];
        $fieldsJson = json_encode($fields, JSON_UNESCAPED_UNICODE);
    ?>
    <div class="service-card" data-cat="<?= $svc['cat_id'] ?>">
        <div class="text-muted" style="font-size:0.8rem;margin-bottom:0.3rem">
            <i class="fas fa-tag"></i> <?= htmlspecialchars($svc['cat_name']) ?>
        </div>
        <h3><?= htmlspecialchars($svc['name']) ?></h3>
        <?php if ($svc['description']): ?>
        <p class="text-muted" style="font-size:0.85rem;margin-top:0.4rem"><?= htmlspecialchars($svc['description']) ?></p>
        <?php endif; ?>
        <div class="price"><?= formatMoney($svc['price']) ?></div>
        <div class="meta">
            <span><i class="fas fa-sort-amount-down"></i> الحد الأدنى: <?= $svc['min_qty'] ?></span>
            <span><i class="fas fa-sort-amount-up"></i> الحد الأقصى: <?= $svc['max_qty'] ?></span>
        </div>
        <?php if (isLoggedIn()): ?>
        <button class="btn btn-primary btn-full" 
                onclick='openOrder(<?= $svc["id"] ?>, "<?= addslashes(htmlspecialchars($svc["name"])) ?>", <?= $svc["price"] ?>, <?= $svc["min_qty"] ?>, <?= $svc["max_qty"] ?>, <?= $fieldsJson ?>)'>
            <i class="fas fa-shopping-cart"></i> اطلب الآن
        </button>
        <?php else: ?>
        <a href="login.php" class="btn btn-secondary btn-full">
            <i class="fas fa-sign-in-alt"></i> سجل دخولك للطلب
        </a>
        <?php endif; ?>
    </div>
    <?php endforeach; ?>
</div>
<?php else: ?>
<div class="empty-state">
    <i class="fas fa-box-open"></i>
    <p>لا توجد خدمات متاحة حالياً</p>
</div>
<?php endif; ?>

<!-- نافذة الطلب -->
<?php if (isLoggedIn()): 
    $user = getUser();
?>
<div class="modal-overlay" id="order-modal">
    <div class="modal">
        <button class="modal-close" onclick="closeModal()"><i class="fas fa-times"></i></button>
        <h3 id="modal-title"><i class="fas fa-shopping-cart"></i> تفاصيل الطلب</h3>
        
        <form method="POST" action="place_order.php">
            <input type="hidden" name="service_id" id="modal-service-id">
            
            <!-- رصيد العميل -->
            <div class="card" style="margin-bottom:1rem;padding:1rem">
                <div style="display:flex;justify-content:space-between;align-items:center">
                    <span class="text-muted"><i class="fas fa-wallet"></i> رصيدك</span>
                    <strong style="color:#00d4aa"><?= formatMoney($user['balance']) ?></strong>
                </div>
            </div>
            
            <!-- الحقول المخصصة -->
            <div id="custom-fields"></div>
            
            <!-- الكمية -->
            <div class="form-group">
                <label>الكمية <span style="color:#8895a7;font-size:0.82rem">(الحد: <span id="qty-min"></span> - <span id="qty-max"></span>)</span></label>
                <div class="qty-control">
                    <button type="button" class="qty-btn" onclick="changeQty(-1)">−</button>
                    <input type="number" id="modal-qty" name="quantity" value="1" min="1" max="9999" required>
                    <button type="button" class="qty-btn" onclick="changeQty(1)">+</button>
                </div>
            </div>
            
            <!-- ملخص السعر -->
            <div class="card" style="margin-bottom:1rem;padding:1rem;background:#0f0f1a">
                <div style="display:flex;justify-content:space-between;margin-bottom:0.5rem">
                    <span class="text-muted">سعر الوحدة</span>
                    <span><span id="modal-price"></span> <?= getSetting('currency_symbol') ?: '$' ?></span>
                </div>
                <div style="display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem">
                    <span>المجموع</span>
                    <span style="color:#00d4aa"><span id="modal-total">0</span> <?= getSetting('currency_symbol') ?: '$' ?></span>
                </div>
            </div>
            
            <button type="submit" class="btn btn-success btn-full">
                <i class="fas fa-check-circle"></i> تأكيد الطلب
            </button>
        </form>
    </div>
</div>
<?php endif; ?>

<?php include 'includes/footer.php'; ?>
