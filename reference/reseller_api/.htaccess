RewriteEngine On

# فرض HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# /client/api/... → client/api/index.php?__path=...
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^client/api/?(.*)$ client/api/index.php?__path=$1 [QSA,L]

# /api-docs → api-docs/index.php
RewriteRule ^api-docs/?$ api-docs/index.php [QSA,L]

Options -Indexes

<FilesMatch "\.(env|ini|log|conf|bak|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header unset X-Powered-By
</IfModule>
